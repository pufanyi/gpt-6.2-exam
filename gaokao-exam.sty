\NewDocumentCommand{\GaokaoTitleBlock}{m m m O{试卷类型：A}}{%
  \begingroup
  \parindent=0pt
  \noindent
  \tikz[baseline=(badge.base)]{%
    \node[draw=black, line width=0.7pt, inner xsep=5pt, inner ysep=2.5pt] (badge)
      {\fontsize{10.5pt}{10.5pt}\selectfont\heiti\bfseries 绝密~\gaokaostar~启用前};
  }%
  \hfill
  {\fontsize{10.5pt}{10.5pt}\selectfont\heiti\bfseries #4}\par
  \vspace{3mm}
